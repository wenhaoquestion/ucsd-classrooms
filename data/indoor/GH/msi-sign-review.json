  "findings": [
    {
      "image": "GH-MSI-DSCN1591",
      "kind": "installed-emergency-plan-photograph",
      "floor": "L2",
      "finding": "Photograph visibly places the evacuation sign beneath the Level 2 marker. The complete printed sheet occupies about 230 by 180 original pixels; its actual floor drawing is smaller. Target room numbers and perimeter details cannot be reliably resolved.",
      "higherResolutionCheck": "Root checked DOM src, srcset and lightbox data-mfp-src. The retained 1500 px wide JPG is the largest declared source; no higher-resolution link was exposed.",
      "usableRoomGeometry": false
    },
    {
      "image": "GH-MSI-DSCN1600",
      "kind": "direct-physical-floor-directory",
      "explicitFloorListings": {
        "L2": [
          "242",
          "247",
          "253",
          "254"
        ],
        "L3": [
          "242",
          "320",
          "321"
        ]
      },
      "finding": "Physical directory lists 242 on both Levels 2 and 3; 247 is Acting/Directing Studio and 253/254 are Conference Rooms on Level 2. This independently corroborates the auditorium floor span and the existing unplaced L2 assignments.",
      "usableRoomGeometry": false
    },
    {
      "images": [
        "GH-MSI-DSCN1581",
        "GH-MSI-DSCN1593",
        "GH-MSI-DSCN1605"
      ],
      "kind": "room-label-and-direction-signs",
      "finding": "Photographs corroborate 247 as Acting/Directing Studio, the conference-room direction to 254, and 321 as Design Collaborative Studio. They do not establish complete room perimeters.",
      "usableRoomGeometry": false
    },
    {
      "sources": [
        "GH-CLICS-L2-2012.jpg",
        "GH-ARCHITECT-2017.jpg"
      ],
      "kind": "cross-source-review",
      "finding": "The 2012 schematic design uniquely names an Acting/Directing Studio, but the 2017 published plan has different nearby partitions and no printed 247 label. The small evacuation photograph cannot resolve this difference. No final room outline is assigned from the schematic proposal."
    }
